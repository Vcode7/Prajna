[Unit]
Description=Prajna Backend FastAPI Service
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/prajna
ExecStart=/opt/prajna/venv/bin/uvicorn backend.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
Environment="PATH=/opt/prajna/venv/bin:/usr/local/bin:/usr/bin:/bin"

[Install]
WantedBy=multi-user.target
