# Primary Groq API Key
GROQ_API_KEY=your_primary_groq_api_key_here

# Groq Model Configuration
DEFAULT_MODEL=qwen/qwen3.8-27b
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# Fallback Groq API Keys (Optional, used for automatic rate-limit key rotation)
GROQ_API_KEY_FALLBACK1=
GROQ_API_KEY_FALLBACK2=
GROQ_API_KEY_FALLBACK3=
GROQ_API_KEY_FALLBACK4=

# Local Ollama Fallback Configuration (Optional, used when all Groq keys are exhausted)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_TIMEOUT=

# Database Paths (Optional, defaults to backend/data/ relative path if omitted)
# DATABASE_URL=sqlite:///e:/projects/sql-llm/backend/data/enterprise_erp.db
# HISTORY_DATABASE_URL=sqlite:///e:/projects/sql-llm/backend/data/history.db

# Performance & Chart Settings
SCHEMA_CACHE_TTL=300
SQL_EXECUTION_TIMEOUT=30.0
MAX_ROWS_LIMIT=1000
USE_AI_CHARTS=false
