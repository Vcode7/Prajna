# ==============================================================================
# PRAJNA Backend Environment Configuration (.env)
# ==============================================================================

# Server Network Configuration
PORT=8000
BACKEND_PORT=8000

# CORS Allowed Origins (Comma-separated for multiple origins, or leave empty for default localhost)
# Example for Linux production: ALLOWED_ORIGINS=http://your-domain.com,http://your-server-ip:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# LLM Configurations & Fallback Priority:
# Priority 1: Groq API (Primary Key -> Fallback Keys 1-4)
# Priority 2: Local Ollama Qwen model (e.g. qwen2.5:7b, qwen3:4b-instruct)
# Priority 3: Local Ollama Gemma model (e.g. gemma2:9b, gemma-4)
# Priority 4: Other available Ollama text models (e.g. llama3.2, mistral, phi3)
# ------------------------------------------------------------------------------

# Primary Groq API Key
GROQ_API_KEY=your_primary_groq_api_key_here

# Fallback Groq API Keys (Optional, used for automatic rate-limit key rotation on HTTP 429)
GROQ_API_KEY_FALLBACK1=
GROQ_API_KEY_FALLBACK2=
GROQ_API_KEY_FALLBACK3=
GROQ_API_KEY_FALLBACK4=

# Groq Model & Parameters
DEFAULT_MODEL=qwen/qwen3.8-27b
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
GROQ_TIMEOUT=60.0

# Local Ollama Fallback Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
# Leave empty for no timeout (recommended for local LLMs) or set in seconds
OLLAMA_TIMEOUT=

# ------------------------------------------------------------------------------
# Database Configurations (SQLite)
# Defaults automatically to backend/data/ relative paths if omitted
# ------------------------------------------------------------------------------
# DATABASE_URL=sqlite:///./backend/data/enterprise_erp.db
# HISTORY_DATABASE_URL=sqlite:///./backend/data/history.db

# ------------------------------------------------------------------------------
# Performance & Execution Settings
# ------------------------------------------------------------------------------
SCHEMA_CACHE_TTL=300
SQL_EXECUTION_TIMEOUT=30.0
MAX_ROWS_LIMIT=1000
USE_AI_CHARTS=false

# Task-Specific Token Limits (Optional tuning)
QUERY_PLANNER_MAX_TOKENS=500
SQL_GENERATION_MAX_TOKENS=800
SQL_REPAIR_MAX_TOKENS=800
ZERO_ROW_REPAIR_MAX_TOKENS=600
EXECUTIVE_SUMMARY_MAX_TOKENS=300
WIDGET_INSIGHT_MAX_TOKENS=500
CHART_GENERATION_MAX_TOKENS=300
CHAT_MAX_TOKENS=1500
