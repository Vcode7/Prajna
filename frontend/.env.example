# PRAJNA Frontend Environment Configuration
# Copy this file to .env or .env.local to customize for your environment.

# Frontend Server Port
VITE_PORT=5173
VITE_HOST=0.0.0.0

# Backend Connection Settings
# In local development, the Vite dev server proxies /api requests to VITE_BACKEND_URL.
# For production builds with a separate backend host, set VITE_API_BASE or VITE_BACKEND_URL.
VITE_BACKEND_HOST=127.0.0.1
VITE_BACKEND_PORT=8000
VITE_BACKEND_URL=http://127.0.0.1:8000

# Base URL for API calls:
# - Leave as /api when using the Vite dev proxy or an Nginx reverse proxy (Recommended)
# - Set to a full URL (e.g. http://your-linux-server:8000/api) for cross-origin deployments
VITE_API_BASE=/api
